# =============================================================================
# Hermes-Revo Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API key.
# The .env file is gitignored — it will NEVER be pushed to GitHub.
#
# For Hermes Agent users: Revo automatically reads API keys from
# Hermes' .env file (~/AppData/Local/hermes/.env on Windows,
# ~/.hermes/.env on Linux/Mac), so you don't even need a .env here.

# =============================================================================
# LLM PROVIDER (OpenAI-compatible)
# =============================================================================
# Your OpenAI-compatible API endpoint
# OpenCode Go: https://opencode.ai/zen/go/v1
# OpenRouter:  https://openrouter.ai/api/v1
# OpenAI:      https://api.openai.com/v1
# LLM_API_BASE_URL=https://opencode.ai/zen/go/v1

# Your API key (get from your provider dashboard)
# LLM_API_KEY=sk-your-key-here

# Default model to use
# LLM_MODEL=deepseek-v4-flash

# =============================================================================
# REVO CONFIG (optional overrides)
# =============================================================================
# These values override revo.yaml. Useful for CI/CD or ad-hoc runs.
# REVO_INTERVAL=10
# REVO_MANIFEST=revo.json
