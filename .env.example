# =============================================================================
# Hermes-Revo Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API key.
# The .env file is gitignored — it will NEVER be pushed to GitHub.
#
# For Hermes Agent users: Revo automatically reads API keys from
# Hermes' .env file (~/AppData/Local/hermes/.env on Windows,
# ~/.hermes/.env on Linux/Mac), so you don't even need a .env here.

# =============================================================================
# AI PROVIDER SELECTION
# =============================================================================
# Choose: "hermes" (default) or "openai" (OpenAI-compatible)
# AI_PROVIDER=hermes

# =============================================================================
# HERMES PROVIDER (default: AI_PROVIDER=hermes)
# =============================================================================
# Your Hermes API endpoint
# HERMES_API_URL=https://opencode.ai/zen/go/v1

# Your Hermes API key
# HERMES_API_KEY=***

# Default model via Hermes
# HERMES_MODEL=deepseek-v4-flash

# =============================================================================
# OPENAI-COMPATIBLE PROVIDER (switch: AI_PROVIDER=openai)
# =============================================================================
# Works with: OpenAI, Ollama, Groq, Together, vLLM, DeepSeek, OpenRouter...
#
# Base URL:
#   OpenAI:      https://api.openai.com/v1
#   Ollama:      http://localhost:11434/v1
#   Groq:        https://api.groq.com/openai/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Your API key
# OPENAI_API_KEY=***

# Model name
# OPENAI_MODEL=gpt-4o

# =============================================================================
# REVO CONFIG (optional overrides)
# =============================================================================
# These values override revo.yaml. Useful for CI/CD or ad-hoc runs.
# REVO_INTERVAL=10
# REVO_MANIFEST=revo.json
